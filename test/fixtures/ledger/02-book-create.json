  "inlineScripts": "\n\n$(document).ready(function(){\n\t$('#startDate').val('2020-1-1');\n});\n\nfunction doSubmit(fbox){\n\tif(!checkForm(fbox)) return;\n\tvar selectDateValue = $('#startDate').val();\n\tvar yyyy = selectDateValue.split(\"-\")[0];\n\tvar mm = selectDateValue.split(\"-\")[1];\n\tvar dd = selectDateValue.split(\"-\")[2];\n\t$('#yyyy').val(yyyy);\n\t$('#mm').val(mm);\n\t$('#dd').val(dd);\n\tfbox.start.value='new_zb_insert_1rec';\n\tfbox.submit();\n}\n\n\nfunction doChgzbnrlb(box)\n{\n    var options = document.getElementById(\"accountid_options_1\").innerHTML;\n    var select_html = \"<select name='accountid'  id='accountid' onkeydown='mySelectBoxKeyPress()'>\"+options+\"</select>\";\n    document.getElementById(\"accountid_span\").innerHTML = select_html;\n\n    if (('4,5,6,7,9').indexOf(box.value) >= 0){\n        box.form.accountid.value='';    \n        box.form.accountid.disabled=true; \n    }   \n    else if (box.value=='1'){\n        box.form.accountid.value='1001';\n        box.form.accountid.disabled=false; \n    }  \n    else if (box.value=='2'){\n        box.form.accountid.value='1002';\n        box.form.accountid.disabled=false; \n    }  \n    else {\n        box.form.accountid.disabled=false;\n    }\n    \n    \n    \n}\n"
